{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.3.1",
  "identifier": "me.legacytech.orbit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#050b18",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LegacyTech",
    "copyright": "LegacyTech",
    "category": "Utility",
    "shortDescription": "Orbit task manager",
    "longDescription": "Orbit, a Windows task manager by LegacyTech.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2NUU2RTMzMEEyQ0ZFNzEKUldSeC9pd0tNMjVleHZrN0JOa3orVzYwNE5iMWtUUk5JeWVMUHB5eU5CVUpMWStDcElxcXFhRkMK",
      "endpoints": [
        "https://github.com/HeshW/orbit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
